
:root {
    --reframe-color-text-dim: rgba(220, 228, 235, 0.85);

    --reframe-color-slate: rgb(126, 146, 166);
    --reframe-color-bundle-accent: rgb(120, 168, 208);
    --reframe-color-bundle-bg: rgba(120, 168, 208, 0.16);

    --reframe-color-blendtree: rgba(126, 146, 166, 0.36);
    --reframe-color-forcedelete: rgba(150, 40, 40, 0.60);
    --reframe-color-requires: rgba(222, 186, 110, 0.40);

    --reframe-color-row-bg: rgba(150, 190, 224, 0.30);
    --reframe-color-row-bg-hover: rgba(170, 206, 236, 0.45);
    --reframe-color-bar-fixed: rgb(96, 108, 120);
    --reframe-color-bar-used: rgb(120, 168, 208);
    --reframe-color-bar-cut: rgb(222, 186, 110);
    --reframe-color-bar-free: rgba(30, 36, 42, 0.7);

    --reframe-color-row-bg-menu-deleted: rgba(84, 118, 146, 0.65);
    --reframe-color-row-bg-gimmick-deleted: rgba(44, 62, 78, 0.82);
    --reframe-color-cascaded-row-bg: rgba(18, 24, 30, 0.90);
    --reframe-radius-row: 9px;
    --reframe-radius-chip: 999px;
    --reframe-radius-checkbox: 4px;

    --reframe-color-category-text: rgb(240, 245, 250);
    --reframe-color-category-border: rgba(150, 190, 224, 0.40);
    --reframe-color-category-border-nested: rgba(150, 190, 224, 0.18);
    --reframe-radius-category: 6px;

    --reframe-color-toggle-checked: rgb(120, 168, 208);
    --reframe-color-field-border: rgba(126, 146, 166, 0.45);

    --reframe-color-toggle-off-bg: rgb(30, 36, 42);
    --reframe-color-toggle-on-text: rgb(22, 34, 46);
    --reframe-color-toggle-off-text: rgb(224, 230, 236);
    --reframe-color-accent-text: rgb(190, 220, 244);

    --reframe-color-panel-bg: rgba(30, 36, 42, 0.55);
    --reframe-color-panel-border: rgba(150, 190, 224, 0.40);
    --reframe-color-panel-text: rgb(240, 245, 250);
    --reframe-color-button-bg: rgb(30, 36, 42);
    --reframe-color-button-text: rgb(224, 230, 236);
    --reframe-color-button-hover-bg: rgb(120, 168, 208);
    --reframe-color-button-hover-text: rgb(22, 34, 46);
    --reframe-color-checkbox-bg: rgb(96, 108, 120);
    --reframe-color-checkbox-border: rgba(240, 245, 250, 0.55);
    --reframe-color-checkbox-checked-bg: rgb(76, 122, 164);
    --reframe-color-checkbox-check: rgb(250, 252, 255);

    --reframe-color-root-bg: rgba(120, 168, 208, 0.14);
    --reframe-radius-root: 8px;

    --reframe-color-locked-bg: rgb(222, 186, 110);
    --reframe-color-locked-text: rgb(40, 30, 16);
}
